{
  "jj-workflow-guard": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "fish \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/hooks/jj_guard.fish\""
          }
        ]
      }
    ]
  },
  "jj-workflow-status": {
    "PostToolUse": [
      {
        "matcher": "run_command|write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "fish \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/hooks/jj_status.fish\""
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "fish \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT:-.}}/hooks/jj_status.fish\""
      }
    ]
  }
}
